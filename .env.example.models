# 环境变量配置示例
# 将此文件复制为 .env.local 并填入实际的配置

# 默认模型配置（JSON 格式）
# 注意：这些配置会被打包到客户端代码中，虽然界面上看不到，但技术上仍可被获取
# 生产环境建议使用服务端代理方案
NEXT_PUBLIC_DEFAULT_MODELS='[
  {
    "name": "OpenAI API",
    "baseUrl": "https://api.openai.com/v1",
    "apiKey": "sk-your-api-key-here",
    "models": [
      {
        "modelId": "gpt-4",
        "label": "GPT-4",
        "description": "OpenAI GPT-4 模型",
        "isStreaming": true
      },
      {
        "modelId": "gpt-3.5-turbo",
        "label": "GPT-3.5 Turbo",
        "description": "OpenAI GPT-3.5 Turbo 模型",
        "isStreaming": true
      }
    ]
  },
  {
    "name": "Anthropic API",
    "baseUrl": "https://api.anthropic.com/v1",
    "apiKey": "sk-ant-your-api-key-here",
    "models": [
      {
        "modelId": "claude-3-opus-20240229",
        "label": "Claude 3 Opus",
        "description": "Anthropic Claude 3 Opus 模型",
        "isStreaming": true
      }
    ]
  }
]'

# 其他环境变量...
